{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "tools/schemas/assets_manifest.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["asset_id", "source_doc_id", "rel_path", "media_type"],
  "properties": {
    "asset_id":       { "type": "string", "pattern": "^asset_[a-f0-9]{12}$" },
    "source_doc_id":  { "type": "string", "pattern": "^doc_[a-f0-9]{12}$" },
    "rel_path":       { "type": "string", "minLength": 1 },
    "media_type":     { "type": "string", "minLength": 3 }
  }
}
