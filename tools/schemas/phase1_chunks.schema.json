{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Phase 1 Chunks Schema",
  "type": "object",
  "properties": {
    "chunk_id": { "type": "string", "pattern": "^doc_[a-f0-9]{12}_[0-9]{5}$" },
    "doc_id": { "type": "string", "pattern": "^doc_[a-f0-9]{12}$" },
    "source_doc_id": { "type": "string", "pattern": "^doc_[a-f0-9]{12}$" },
    "text": { "type": "string", "minLength": 1 },
    "source_page_id": {
      "type": "integer",
      "minimum": 0,
      "description": "The zero-indexed page of origin. For non-paged media (images, audio, txt), this is always 0."
    }
  },
  "required": ["chunk_id", "doc_id", "source_doc_id", "source_page_id", "text"]
}
