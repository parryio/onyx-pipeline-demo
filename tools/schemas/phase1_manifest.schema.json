{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Phase 1 Manifest Schema",
  "type": "object",
  "properties": {
    "doc_id": { "type": "string", "pattern": "^doc_[a-f0-9]{12}$" },
    "path": { "type": "string" },
    "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
  },
  "required": ["doc_id", "path", "sha256"]
}
