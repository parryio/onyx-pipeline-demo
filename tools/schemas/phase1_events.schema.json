{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Phase 1 Events Schema",
  "type": "object",
  "properties": {
    "doc_id": { "type": "string", "pattern": "^doc_[a-f0-9]{12}$" },
  "status": { "type": "string", "enum": ["text_direct", "text_layer", "ocr_full", "ocr_rescue", "quarantined", "audio_cataloged"] },
    "details": { "type": "string" }
  },
  "required": ["doc_id", "status", "details"]
}
