{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Phase 4 Crosslink Record",
  "type": "object",
  "required": ["type", "kit_id"],
  "properties": {
    "type": {"type": "string", "enum": ["kit_step", "kit_doc"]},
    "kit_id": {"type": "string"},
    "ritual_step_id": {"type": "string"},
    "doc_id": {"type": "string"}
  },
  "additionalProperties": false,
  "allOf": [
    {"if": {"properties": {"type": {"const": "kit_step"}}}, "then": {"required": ["ritual_step_id"]}},
    {"if": {"properties": {"type": {"const": "kit_doc"}}}, "then": {"required": ["doc_id"]}}
  ]
}