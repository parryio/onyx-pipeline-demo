{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Phase 2 Embedding Record",
  "type": "object",
  "required": ["chunk_id", "vector"],
  "properties": {
    "chunk_id": {"type": ["string", "integer"]},
    "doc_id": {"type": ["string", "integer"]},
    "vector": {
      "type": "array",
      "minItems": 8,
      "maxItems": 8,
      "items": {"type": "number"}
    }
  },
  "additionalProperties": true
}
